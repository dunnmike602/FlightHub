################################################################################
# This .gitignore file was generated/updated for Visual Studio 2026 and C# projects.
################################################################################

# User-specific files
.vs/
*.suo
*.user
*.userosscache
*.sln.docstates

# Build results
bin/
obj/
out/
**/bin/
**/obj/

# Visual Studio Code workspace settings
.vscode/

# Rider
.idea/
*.sln.iml

# NuGet
packages/
*.nupkg
.nuget/packages/
.packages/
~/.nuget/packages

# MSBuild generated files
project.lock.json
project.assets.json
msbuild.log

# Test results
TestResults/
*.trx
*.coverage
*.coveragexml

# Profiling
*.psess
*.vsp
*.vspx

# Web publish
*.Publish.xml

# Database files
*.mdf
*.ldf

# OS generated files
Thumbs.db
ehthumbs.db
.DS_Store

# Logs
*.log

# Certificates
*.pfx
*.p12

# Local secrets and settings
local.settings.json
appsettings.*.Local.json

# Rider settings
*.DotSettings.user

# End of .gitignore
